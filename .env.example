# --- Database (async driver for the app; Alembic derives the sync form) ---
DATABASE_URL=postgresql+asyncpg://localdash:localdash@localhost:5432/localdash

# --- Hamilton County 911 source ---
HC911_API_URL=https://hc911server.com/api/calls
HC911_AUTH_TOKEN=my-secure-token
HC911_ORIGIN=https://www.hamiltontn911.gov
HC911_POLL_INTERVAL=60
HC911_ENABLED=true

# Identify ourselves politely to upstream servers.
USER_AGENT=LocalDash/0.1 (+https://github.com/your/localdash)

# Map tile layer used by the frontend.
TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}
TILE_ATTRIBUTION=Tiles &copy; Esri

# How long to retain observation history (days). 0 = keep forever.
RETENTION_DAYS=0

# --- Events feature (aggregated area events) ---
# Nothing is configured by default; the feature starts empty until you set
# one or more iCal feed URLs and/or a Meetup token.
EVENTS_ENABLED=true
EVENTS_REFRESH_MINUTES=60
# Comma-separated .ics feed URLs.
EVENTS_ICAL_FEEDS=
# Meetup OAuth2 access token; empty = Meetup source not registered.
EVENTS_MEETUP_TOKEN=
# Optional Meetup keyword filter.
EVENTS_MEETUP_QUERY=
# Nominatim requires a descriptive User-Agent (usage policy).
EVENTS_GEOCODER_USER_AGENT=LocalDash/0.1 (events geocoder)
